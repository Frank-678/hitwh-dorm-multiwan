#!/bin/sh

MAX_PATHS="$(uci -q get hitwh_mwan.main.max_paths)"
PARENT_DEVICE="$(uci -q get hitwh_mwan.main.parent_device)"
MAIN_INTERFACE="$(uci -q get hitwh_mwan.main.main_interface)"
LOCK=/var/run/hitwh-mwan-update.lock
UPDATE_COMMAND="${HITWH_MWAN_UPDATE:-/usr/sbin/hitwh-mwan-update}"
STATUS_FILE="${HITWH_MWAN_STATUS:-/tmp/hitwh-mwan.status}"

[ -n "$MAX_PATHS" ] || MAX_PATHS=17
[ -n "$PARENT_DEVICE" ] || PARENT_DEVICE=eth1
[ -n "$MAIN_INTERFACE" ] || MAIN_INTERFACE=wan

usage() {
	cat <<'EOF'
HITwh dorm multi-WAN manager

Usage:
  hitwh-mwan set-main AA:BB:CC:DD:EE:FF
  hitwh-mwan add AA:BB:CC:DD:EE:FF
  hitwh-mwan edit <wan|wanN|number|old-MAC> AA:BB:CC:DD:EE:FF
  hitwh-mwan remove <number|wanN|MAC>
  hitwh-mwan list
  hitwh-mwan refresh
  hitwh-mwan speed [seconds]
EOF
}

wan_zone() {
	for Z in $(uci show firewall | sed -n "s/^\(firewall\.[^.]*\)=zone$/\1/p"); do
		[ "$(uci -q get "$Z.name")" = wan ] && {
			echo "$Z"
			return 0
		}
	done
	return 1
}

wait_for_updater() {
	WAIT_LOCK=0
	while [ -d "$LOCK" ] && [ "$WAIT_LOCK" -lt 15 ]; do
		sleep 1
		WAIT_LOCK=$((WAIT_LOCK + 1))
	done
}

run_update() {
	wait_for_updater
	"$UPDATE_COMMAND"
}

normalize_mac() {
	echo "$1" | tr 'A-F' 'a-f'
}

valid_mac() {
	MAC="$1"
	echo "$MAC" | grep -Eq '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' || return 1
	[ "$MAC" != 00:00:00:00:00:00 ] || return 1
	FIRST="${MAC%%:*}"
	[ $((0x$FIRST & 1)) -eq 0 ]
}

backup_network() {
	BACKUP_DIR=/root/hitwh-mwan-backups
	mkdir -p "$BACKUP_DIR"
	chmod 700 "$BACKUP_DIR"
	cp /etc/config/network "$BACKUP_DIR/network-$(date +%Y%m%d-%H%M%S)"
}

find_device_section() {
	for DEV_SECTION in $(uci show network | sed -n 's/^\(network\.[^.]*\)=device$/\1/p'); do
		[ "$(uci -q get "$DEV_SECTION.name")" = "$1" ] || continue
		echo "$DEV_SECTION"
		return 0
	done
	return 1
}

runtime_mac() {
	normalize_mac "$(cat "/sys/class/net/$1/address" 2>/dev/null)"
}

read_main_mac() {
	MAIN_DEVICE="$(uci -q get "network.$MAIN_INTERFACE.device")"
	[ -n "$MAIN_DEVICE" ] || MAIN_DEVICE="$PARENT_DEVICE"
	MAIN_DEV_SECTION="$(find_device_section "$MAIN_DEVICE" || true)"
	MAIN_CONFIG_MAC="$(normalize_mac "$(uci -q get "network.$MAIN_INTERFACE.macaddr")")"
	MAIN_DEVICE_MAC=""
	[ -z "$MAIN_DEV_SECTION" ] || MAIN_DEVICE_MAC="$(normalize_mac "$(uci -q get "$MAIN_DEV_SECTION.macaddr")")"
	MAIN_RUNTIME_MAC="$(runtime_mac "$MAIN_DEVICE")"
}

main_uses_mac() {
	[ "$1" = "$MAIN_CONFIG_MAC" ] || [ "$1" = "$MAIN_DEVICE_MAC" ] || [ "$1" = "$MAIN_RUNTIME_MAC" ]
}

wait_for_mac() {
	MAC_WAIT=0
	while [ "$MAC_WAIT" -lt 5 ]; do
		ACTUAL_MAC="$(runtime_mac "$1")"
		[ "$ACTUAL_MAC" = "$2" ] && return 0
		sleep 1
		MAC_WAIT=$((MAC_WAIT + 1))
	done
	return 1
}

find_by_mac() {
	WANT="$(normalize_mac "$1")"
	N=2
	while [ "$N" -le "$MAX_PATHS" ]; do
		if [ "$N" -eq 6 ]; then N=$((N + 1)); continue; fi
		HAVE="$(normalize_mac "$(uci -q get "network.wan${N}dev.macaddr")")"
		[ -n "$HAVE" ] && [ "$HAVE" = "$WANT" ] && {
			echo "$N"
			return 0
		}
		N=$((N + 1))
	done
	return 1
}

is_managed_path() {
	SLOT="$1"
	IFACE="wan$SLOT"
	DSEC="wan${SLOT}dev"
	EXPECTED_DEV="macwan$SLOT"

	TYPE="$(uci -q get "network.$DSEC.type" || true)"
	PARENT="$(uci -q get "network.$DSEC.ifname" || true)"
	DEVICE="$(uci -q get "network.$IFACE.device" || true)"
	PROTO="$(uci -q get "network.$IFACE.proto" || true)"

	[ "$TYPE" = macvlan ] &&
		[ "$PARENT" = "$PARENT_DEVICE" ] &&
		[ "$DEVICE" = "$EXPECTED_DEV" ] &&
		[ "$PROTO" = dhcp ]
}

wait_for_ip() {
	IFACE="$1"
	WAIT=0
	IP=""
	while [ "$WAIT" -lt 30 ]; do
		IP="$(ubus call "network.interface.$IFACE" status 2>/dev/null |
			jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)"
		[ -n "$IP" ] && break
		sleep 1
		WAIT=$((WAIT + 1))
	done
	echo "$IP"
}

cmd_set_main() {
	cmd_edit "$MAIN_INTERFACE" "$1"
}

cmd_add() {
	MAC="$(normalize_mac "$1")"
	valid_mac "$MAC" || {
		echo "Error: invalid, zero or multicast MAC address."
		exit 2
	}

	read_main_mac
	main_uses_mac "$MAC" && {
		echo "Error: this MAC is already used by the main WAN."
		exit 3
	}

	EXISTING="$(find_by_mac "$MAC" || true)"
	[ -z "$EXISTING" ] || {
		echo "This MAC is already configured as wan$EXISTING."
		exit 0
	}

	SLOT=""
	N=2
	while [ "$N" -le "$MAX_PATHS" ]; do
		if [ "$N" -eq 6 ]; then N=$((N + 1)); continue; fi
		if ! uci -q get "network.wan$N" >/dev/null; then
			SLOT="$N"
			break
		fi
		N=$((N + 1))
	done
	[ -n "$SLOT" ] || {
		echo "Error: the configured maximum of $MAX_PATHS paths has been reached."
		exit 4
	}

	IFACE="wan$SLOT"
	DEV="macwan$SLOT"
	DSEC="wan${SLOT}dev"
	ZONE="$(wan_zone)" || {
		echo "Error: OpenWrt WAN firewall zone was not found."
		exit 5
	}

	wait_for_updater
	backup_network
	uci -q delete "network.$DSEC"
	uci set "network.$DSEC=device"
	uci set "network.$DSEC.name=$DEV"
	uci set "network.$DSEC.type=macvlan"
	uci set "network.$DSEC.ifname=$PARENT_DEVICE"
	uci set "network.$DSEC.mode=bridge"
	uci set "network.$DSEC.macaddr=$MAC"

	uci -q delete "network.$IFACE"
	uci set "network.$IFACE=interface"
	uci set "network.$IFACE.device=$DEV"
	uci set "network.$IFACE.proto=dhcp"
	uci set "network.$IFACE.metric=$((SLOT * 10))"
	uci set "network.$IFACE.defaultroute=0"
	uci set "network.$IFACE.peerdns=0"
	uci set "network.$IFACE.delegate=0"

	uci -q del_list "$ZONE.network=$IFACE" || true
	uci add_list "$ZONE.network=$IFACE"
	uci commit network
	uci commit firewall

	/etc/init.d/network reload
	ifup "$IFACE"
	/etc/init.d/firewall reload >/dev/null 2>&1 || true
	IP="$(wait_for_ip "$IFACE")"
	run_update

	if [ -n "$IP" ]; then
		STATE="$(grep "^$IFACE " /tmp/hitwh-mwan.status | sed -n 's/.* state=\([^ ]*\).*/\1/p')"
		echo "Added $IFACE: MAC=$MAC IP=$IP state=${STATE:-unknown}"
	else
		echo "Created $IFACE, but DHCP has not returned an address. The monitor will retry."
	fi
}

resolve_slot() {
	ARG="$1"
	case "$ARG" in
		wan[0-9]*) echo "${ARG#wan}"; return 0 ;;
		*[!0-9]*|'')
			case "$ARG" in
				*:*) find_by_mac "$ARG"; return $? ;;
			esac
			;;
		*) echo "$ARG"; return 0 ;;
	esac
	return 1
}

cmd_edit() {
	MAC="$(normalize_mac "$2")"
	valid_mac "$MAC" || {
		echo "Error: invalid, zero or multicast MAC address."
		return 2
	}
	read_main_mac
	EXTRA_EDIT_KEY=""
	EXTRA_OLD_MAC=""
	CREATE_MAIN_DEVICE=0

	case "$1" in
		"$MAIN_INTERFACE"|wan1|1)
			EDIT_IFACE="$MAIN_INTERFACE"
			EDIT_DEVICE="$MAIN_DEVICE"
			EDIT_KEY="network.$MAIN_INTERFACE.macaddr"
			OLD_MAC="$MAIN_CONFIG_MAC"
			EXTRA_OLD_MAC="$MAIN_DEVICE_MAC"
			if [ -n "$MAIN_DEV_SECTION" ]; then
				EXTRA_EDIT_KEY="$MAIN_DEV_SECTION.macaddr"
			else
				# Modern OpenWrt applies L2 settings to device sections. Create
				# our own only when no named/anonymous section owns this device.
				NEW_DEV_SECTION=network.hitwh_main_device
				if uci -q get "$NEW_DEV_SECTION" >/dev/null; then
					echo "Error: $NEW_DEV_SECTION already configures another device."
					return 4
				fi
				CREATE_MAIN_DEVICE=1
				EXTRA_EDIT_KEY="$NEW_DEV_SECTION.macaddr"
			fi
			;;
		*)
			EDIT_SLOT="$(resolve_slot "$1" || true)"
			case "$EDIT_SLOT" in
				''|0*|*[!0-9]*) echo "Error: invalid WAN identifier."; return 2 ;;
			esac
			[ "$EDIT_SLOT" -ge 2 ] && [ "$EDIT_SLOT" -le "$MAX_PATHS" ] || {
				echo "Error: path number is out of range."
				return 2
			}
			EDIT_IFACE="wan$EDIT_SLOT"
			EDIT_DEVICE="macwan$EDIT_SLOT"
			EDIT_KEY="network.wan${EDIT_SLOT}dev.macaddr"
			OLD_MAC="$(normalize_mac "$(uci -q get "$EDIT_KEY")")"
			EXTRA_OLD_MAC="$(normalize_mac "$(uci -q get "network.$EDIT_IFACE.macaddr")")"
			[ -z "$EXTRA_OLD_MAC" ] || EXTRA_EDIT_KEY="network.$EDIT_IFACE.macaddr"
			;;
	esac
	uci -q get "network.$EDIT_IFACE" >/dev/null || {
		echo "Error: $EDIT_IFACE does not exist."
		return 3
	}
	if [ "$EDIT_IFACE" != "$MAIN_INTERFACE" ]; then
		[ "$EDIT_SLOT" -ne 6 ] && is_managed_path "$EDIT_SLOT" || {
			echo "Refusing to edit $EDIT_IFACE: it is not a managed HITwh multi-WAN path."
			return 4
		}
	fi
	if [ "$EDIT_IFACE" != "$MAIN_INTERFACE" ] && main_uses_mac "$MAC"; then
		echo "Error: this MAC is already used by $MAIN_INTERFACE."
		return 3
	fi
	EXISTING="$(find_by_mac "$MAC" || true)"
	if [ -n "$EXISTING" ] && [ "wan$EXISTING" != "$EDIT_IFACE" ]; then
		echo "Error: this MAC is already used by wan$EXISTING."
		return 3
	fi
	RUNTIME_MAC="$(runtime_mac "$EDIT_DEVICE")"
	if [ "$MAC" = "$RUNTIME_MAC" ] &&
		{ [ -z "$OLD_MAC" ] || [ "$MAC" = "$OLD_MAC" ]; } &&
		{ [ -z "$EXTRA_OLD_MAC" ] || [ "$MAC" = "$EXTRA_OLD_MAC" ]; }; then
		echo "$EDIT_IFACE already uses MAC=$MAC. No changes."
		return 0
	fi

	wait_for_updater
	[ ! -d "$LOCK" ] || { echo "Error: the WAN updater is busy; retry shortly."; return 1; }
	backup_network || return 1
	if [ "$CREATE_MAIN_DEVICE" = 1 ]; then
		uci set "$NEW_DEV_SECTION=device" || return 1
		uci set "$NEW_DEV_SECTION.name=$EDIT_DEVICE" || return 1
	fi
	uci set "$EDIT_KEY=$MAC" || return 1
	[ -z "$EXTRA_EDIT_KEY" ] || uci set "$EXTRA_EDIT_KEY=$MAC" || return 1
	if ! uci commit network; then
		uci -q revert "$EDIT_KEY" || true
		[ -z "$EXTRA_EDIT_KEY" ] || uci -q revert "$EXTRA_EDIT_KEY" || true
		[ "$CREATE_MAIN_DEVICE" = 0 ] || uci -q revert "$NEW_DEV_SECTION" || true
		echo "Error: could not save the MAC change."
		return 1
	fi
	ifdown "$EDIT_IFACE" || true
	# Withdraw the down path and move the router's default exit before waiting
	# for the replacement MAC's DHCP. Other paths keep their routing marks.
	run_update >/dev/null 2>&1 || true
	if ! /etc/init.d/network reload; then
		ifup "$EDIT_IFACE" || true
		echo "Error: MAC saved, but network reload failed."
		return 1
	fi
	ifup "$EDIT_IFACE" || return 1
	if ! wait_for_mac "$EDIT_DEVICE" "$MAC"; then
		run_update >/dev/null 2>&1 || true
		echo "Error: requested MAC=$MAC, but $EDIT_DEVICE uses MAC=${ACTUAL_MAC:-unavailable}. MAC change was not applied."
		return 1
	fi
	IP="$(wait_for_ip "$EDIT_IFACE")"
	run_update || return 1
	if [ -n "$IP" ]; then
		STATE="$(grep "^$EDIT_IFACE " "$STATUS_FILE" | sed -n 's/.* state=\([^ ]*\).*/\1/p')"
		echo "Updated $EDIT_IFACE: MAC=$MAC IP=$IP state=${STATE:-unknown}"
	else
		echo "Updated $EDIT_IFACE: MAC=$MAC ip=none state=no-dhcp. DHCP has not returned an address yet."
	fi
}

cmd_remove() {
	SLOT="$(resolve_slot "$1" || true)"
	case "$SLOT" in
		''|1|*[!0-9]*)
			echo "Error: only wan2 through wan$MAX_PATHS can be removed."
			exit 2
			;;
	esac
	[ "$SLOT" -le "$MAX_PATHS" ] || {
		echo "Error: path number is out of range."
		exit 2
	}

	IFACE="wan$SLOT"
	DSEC="wan${SLOT}dev"
	uci -q get "network.$IFACE" >/dev/null || {
		echo "$IFACE does not exist."
		exit 3
	}
	is_managed_path "$SLOT" || {
		echo "Refusing to remove $IFACE: it was not created by HITwh dorm multi-WAN."
		exit 4
	}
	ZONE="$(wan_zone)" || exit 5

	wait_for_updater
	backup_network
	ifdown "$IFACE" || true
	uci -q delete "network.$IFACE"
	uci -q delete "network.$DSEC"
	uci -q del_list "$ZONE.network=$IFACE" || true
	uci commit network
	uci commit firewall
	/etc/init.d/network reload
	/etc/init.d/firewall reload >/dev/null 2>&1 || true
	run_update
	echo "Removed $IFACE. Existing connections on that path were closed."
}

cmd_list() {
	run_update
	print_status
}

print_status() {
	cat "$STATUS_FILE"
	if ! grep -q "^$MAIN_INTERFACE " "$STATUS_FILE"; then
		MAC="$(uci -q get "network.$MAIN_INTERFACE.macaddr")"
		[ -n "$MAC" ] || MAC="$(cat "/sys/class/net/$PARENT_DEVICE/address" 2>/dev/null)"
		echo "$MAIN_INTERFACE mac=$MAC ip=none state=no-dhcp mark=0x101"
	fi

	N=2
	while [ "$N" -le "$MAX_PATHS" ]; do
		if [ "$N" -eq 6 ]; then N=$((N + 1)); continue; fi
		if is_managed_path "$N" && ! grep -q "^wan$N " "$STATUS_FILE"; then
			MAC="$(uci -q get "network.wan${N}dev.macaddr")"
			echo "wan$N mac=$MAC ip=none state=no-dhcp"
		fi
		N=$((N + 1))
	done
}

managed_paths() {
	echo "$MAIN_INTERFACE"
	N=2
	while [ "$N" -le "$MAX_PATHS" ]; do
		if [ "$N" -eq 6 ]; then N=$((N + 1)); continue; fi
		is_managed_path "$N" && echo "wan$N"
		N=$((N + 1))
	done
}

cmd_refresh() {
	run_update
	OFFLINE=""
	for IFACE in $(managed_paths); do
		grep -q "^$IFACE .* state=active" "$STATUS_FILE" || OFFLINE="$OFFLINE $IFACE"
	done

	set -- $OFFLINE
	ATTEMPTED=$#
	if [ "$ATTEMPTED" -eq 0 ]; then
		print_status
		echo "RESULT 0 0 0"
		return 0
	fi

	for IFACE in "$@"; do ifdown "$IFACE" >/dev/null 2>&1 || true; done
	sleep 1
	for IFACE in "$@"; do ifup "$IFACE" >/dev/null 2>&1 || true; done

	WAIT=0
	while [ "$WAIT" -lt 20 ]; do
		PENDING=0
		for IFACE in "$@"; do
			IP="$(ubus call "network.interface.$IFACE" status 2>/dev/null |
				jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)"
			[ -n "$IP" ] || PENDING=$((PENDING + 1))
		done
		[ "$PENDING" -eq 0 ] && break
		sleep 1
		WAIT=$((WAIT + 1))
	done

	run_update
	REMAINING=0
	for IFACE in "$@"; do
		grep -q "^$IFACE .* state=active" "$STATUS_FILE" || REMAINING=$((REMAINING + 1))
	done
	RECOVERED=$((ATTEMPTED - REMAINING))
	print_status
	echo "RESULT $ATTEMPTED $RECOVERED $REMAINING"
	[ "$REMAINING" -eq 0 ]
}

cmd_speed() {
	SECONDS_TO_RUN="${1:-0}"
	case "$SECONDS_TO_RUN" in *[!0-9]*) echo "Error: seconds must be an integer."; exit 2 ;; esac
	COUNTER="/sys/class/net/$PARENT_DEVICE/statistics/rx_bytes"
	[ -r "$COUNTER" ] || {
		echo "Error: cannot read RX counter for $PARENT_DEVICE."
		exit 3
	}

	LAST="$(cat "$COUNTER")"
	ELAPSED=0
	while [ "$SECONDS_TO_RUN" -eq 0 ] || [ "$ELAPSED" -lt "$SECONDS_TO_RUN" ]; do
		sleep 1
		NOW="$(cat "$COUNTER")"
		awk -v bytes="$((NOW - LAST))" 'BEGIN { printf "%.2f MB/s\n", bytes / 1048576 }'
		LAST="$NOW"
		ELAPSED=$((ELAPSED + 1))
	done
}

case "$1" in
	set-main)
		[ -n "$2" ] || { usage; exit 1; }
		cmd_set_main "$2"
		;;
	add)
		[ -n "$2" ] || { usage; exit 1; }
		cmd_add "$2"
		;;
	edit)
		[ "$#" -eq 3 ] || { usage; exit 1; }
		cmd_edit "$2" "$3"
		;;
	remove)
		[ -n "$2" ] || { usage; exit 1; }
		cmd_remove "$2"
		;;
	list)
		cmd_list
		;;
	refresh)
		cmd_refresh
		;;
	speed)
		cmd_speed "$2"
		;;
	*)
		usage
		exit 1
		;;
esac
