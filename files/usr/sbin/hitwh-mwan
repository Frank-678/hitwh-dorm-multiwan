#!/bin/sh

set +x
set +a
umask 077
MAX_PATHS="$(uci -q get hitwh_mwan.main.max_paths)"
PARENT_DEVICE="$(uci -q get hitwh_mwan.main.parent_device)"
MAIN_INTERFACE="$(uci -q get hitwh_mwan.main.main_interface)"
MAIN_ENROLLED="$(uci -q get hitwh_mwan.main.main_enrolled)"
LOCK=/var/run/hitwh-mwan-update.lock
UPDATE_COMMAND="${HITWH_MWAN_UPDATE:-/usr/sbin/hitwh-mwan-update}"
STATUS_FILE="${HITWH_MWAN_STATUS:-/tmp/hitwh-mwan.status}"
AUTH_COMMAND="${HITWH_MWAN_AUTH:-/usr/sbin/hitwh-mwan-auth}"
MANAGEMENT_LOCK="${HITWH_MWAN_MANAGEMENT_LOCK:-${HITWH_MWAN_REFRESH_LOCK:-/var/run/hitwh-mwan-management.lock}}"
AUTH_DIR="${HITWH_MWAN_AUTH_DIR:-/etc/hitwh-mwan/auth.d}"
AUTH_BASE="$(dirname "$AUTH_DIR")"
HISTORY="$AUTH_BASE/mac-history"
PENDING_DIR=""
HISTORY_TEMP=""
AUTH_PIDS=""
WATCHDOG_PID=""
ROLLBACK=0

rollback_random() {
	# These names were verified unused while holding the management lock.
	"$AUTH_COMMAND" remove "$NEW_IFACE" >/dev/null 2>&1 || true
	ifdown "$NEW_IFACE" >/dev/null 2>&1 || true
	uci -q delete "network.$NEW_IFACE" || true
	uci -q delete "network.$NEW_DSEC" || true
	uci -q del_list "$ZONE.network=$NEW_IFACE" || true
	uci commit network && uci commit firewall || echo 'Error: rollback could not be saved.' >&2
	/etc/init.d/network reload >/dev/null 2>&1 || true
	/etc/init.d/firewall reload >/dev/null 2>&1 || true
	run_update >/dev/null 2>&1 || true
}
cleanup_manager() {
	for AUTH_PID in $AUTH_PIDS; do kill "$AUTH_PID" 2>/dev/null || true; done
	[ -z "$WATCHDOG_PID" ] || kill "$WATCHDOG_PID" 2>/dev/null || true
	for AUTH_PID in $AUTH_PIDS; do wait "$AUTH_PID" 2>/dev/null || true; done
	[ -z "$WATCHDOG_PID" ] || wait "$WATCHDOG_PID" 2>/dev/null || true
	[ "$ROLLBACK" = 0 ] || rollback_random
	[ -z "$PENDING_DIR" ] || rm -rf "$PENDING_DIR"
	[ -z "$HISTORY_TEMP" ] || rm -f "$HISTORY_TEMP"
}
trap cleanup_manager EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

acquire_management_lock() {
	command -v flock >/dev/null 2>&1 || { echo 'Error: flock is required.' >&2; return 1; }
	[ ! -L "$MANAGEMENT_LOCK" ] || return 1
	exec 9>"$MANAGEMENT_LOCK" || return 1
	flock -n 9 || { echo 'Error: another WAN management operation is in progress.' >&2; return 1; }
}

start_refresh_budget() {
	MANAGER_PID=$$
	(
		TIMER_SLEEP=""
		trap '[ -z "$TIMER_SLEEP" ] || kill "$TIMER_SLEEP" 2>/dev/null || true' EXIT
		trap 'exit 0' TERM INT HUP
		sleep 270 & TIMER_SLEEP=$!
		wait "$TIMER_SLEEP" || exit 0
		echo 'Error: manual refresh time budget exhausted.' >&2
		kill -TERM "$MANAGER_PID"
	) &
	WATCHDOG_PID=$!
}

wait_auth_batch() {
	for AUTH_PID in $AUTH_PIDS; do wait "$AUTH_PID" || true; done
	AUTH_PIDS=""
}

[ -n "$MAX_PATHS" ] || MAX_PATHS=17
[ -n "$PARENT_DEVICE" ] || PARENT_DEVICE=eth1
[ -n "$MAIN_INTERFACE" ] || MAIN_INTERFACE=wan
[ -n "$MAIN_ENROLLED" ] || MAIN_ENROLLED=1

usage() {
	cat <<'EOF'
HITwh dorm multi-WAN manager

Usage:
  hitwh-mwan set-main AA:BB:CC:DD:EE:FF
  hitwh-mwan add AA:BB:CC:DD:EE:FF
  hitwh-mwan add random [--stdin]
  hitwh-mwan edit <wan|wanN|number|old-MAC> AA:BB:CC:DD:EE:FF
  hitwh-mwan remove <wan|number|wanN|MAC>
  hitwh-mwan list
  hitwh-mwan refresh [wan|wanN]
  hitwh-mwan portal [wan|wanN]
  hitwh-mwan upgrade
  hitwh-mwan auth set <wan|wanN>
  hitwh-mwan auth status [wan|wanN]
  hitwh-mwan auth remove <wan|wanN>
  hitwh-mwan speed [seconds]
EOF
}

wan_zone() {
	for Z in $(uci show firewall | sed -n "s/^\(firewall\.[^.]*\)=zone$/\1/p"); do
		[ "$(uci -q get "$Z.name")" = wan ] && {
			echo "$Z"
			return 0
		}
	done
	return 1
}

wait_for_updater() {
	WAIT_LOCK=0
	while [ -d "$LOCK" ] && [ "$WAIT_LOCK" -lt 15 ]; do
		sleep 1
		WAIT_LOCK=$((WAIT_LOCK + 1))
	done
}

run_update() {
	wait_for_updater
	[ ! -d "$LOCK" ] || { echo 'Error: the WAN updater is busy; retry shortly.' >&2; return 1; }
	"$UPDATE_COMMAND"
}

normalize_mac() {
	echo "$1" | tr 'A-F' 'a-f'
}

valid_mac() {
	MAC="$1"
	echo "$MAC" | grep -Eq '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' || return 1
	[ "$MAC" != 00:00:00:00:00:00 ] || return 1
	FIRST="${MAC%%:*}"
	[ $((0x$FIRST & 1)) -eq 0 ]
}

find_free_slot() {
	N=2
	while [ "$N" -le "$MAX_PATHS" ]; do
		if [ "$N" -ne 6 ] &&
			! uci -q get "network.wan$N" >/dev/null &&
			! uci -q get "network.wan${N}dev" >/dev/null &&
			[ ! -e "/sys/class/net/macwan$N" ] &&
			[ ! -e "$AUTH_DIR/wan$N.json" ] && [ ! -L "$AUTH_DIR/wan$N.json" ] &&
			! find_device_section "macwan$N" >/dev/null; then
			echo "$N"; return 0
		fi
		N=$((N + 1))
	done
	return 1
}

history_storage() {
	[ "$(id -u)" = 0 ] || { echo 'Error: root is required.' >&2; return 1; }
	[ ! -L "$AUTH_BASE" ] && [ ! -L "$AUTH_DIR" ] && [ ! -L "$HISTORY" ] || return 1
	[ -e "$AUTH_BASE" ] || mkdir -m 700 "$AUTH_BASE" || return 1
	[ "$(stat -c '%u:%a' "$AUTH_BASE")" = 0:700 ] && [ -d "$AUTH_BASE" ] || return 1
	if [ -e "$AUTH_DIR" ]; then
		[ -d "$AUTH_DIR" ] && [ "$(stat -c '%u:%a' "$AUTH_DIR")" = 0:700 ] || return 1
	fi
	if [ -e "$HISTORY" ]; then
		[ -f "$HISTORY" ] && [ "$(stat -c '%u:%a' "$HISTORY")" = 0:600 ] || return 1
		LC_ALL=C grep -qvE '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' "$HISTORY" && return 1
	fi
	return 0
}

known_macs() {
	# Read only MAC fields into the history, never copy credential/config data.
	uci show network | sed -n "s/^[^=]*\.macaddr=['\"]\{0,1\}\([^'\"]*\)['\"]\{0,1\}$/\1/p"
	for ADDRESS in /sys/class/net/*/address; do cat "$ADDRESS" 2>/dev/null; done
	for RECORD in "$AUTH_DIR"/*.json; do
		[ -f "$RECORD" ] || continue
		jsonfilter -i "$RECORD" -e '@.mac' 2>/dev/null
	done
	if [ -d /root/hitwh-mwan-backups ]; then
		find /root/hitwh-mwan-backups -type f -name 'network*' | while IFS= read -r BACKUP; do
			awk '$1=="option" && $2=="macaddr" {gsub(/[\047\042]/,"",$3); print $3}' "$BACKUP"
		done
	fi
}

initialize_history() {
	history_storage || { echo 'Error: MAC history storage is not private.' >&2; return 1; }
	for RECORD in "$AUTH_DIR"/*.json; do
		[ -e "$RECORD" ] || [ -L "$RECORD" ] || continue
		[ ! -L "$RECORD" ] && [ -f "$RECORD" ] &&
			[ "$(stat -c '%u:%a' "$RECORD")" = 0:600 ] || return 1
		SAVED_MAC="$(jsonfilter -i "$RECORD" -e '@.mac' 2>/dev/null | tr 'A-F' 'a-f')"
		printf '%s' "$SAVED_MAC" | grep -Eq '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' || return 1
	done
	HISTORY_TEMP="$(mktemp "$AUTH_BASE/.history.XXXXXX")" || return 1
	{
		[ ! -e "$HISTORY" ] || cat "$HISTORY"
		known_macs
	} | tr 'A-F' 'a-f' | grep -E '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' | sort -u >"$HISTORY_TEMP" || return 1
	chmod 600 "$HISTORY_TEMP" && mv -f "$HISTORY_TEMP" "$HISTORY" || return 1
	HISTORY_TEMP=""
}

create_random_path() {
	uci set "network.$NEW_DSEC=device" &&
	uci set "network.$NEW_DSEC.name=$NEW_DEVICE" &&
	uci set "network.$NEW_DSEC.type=macvlan" &&
	uci set "network.$NEW_DSEC.ifname=$PARENT_DEVICE" &&
	uci set "network.$NEW_DSEC.mode=bridge" &&
	uci set "network.$NEW_DSEC.macaddr=$NEW_MAC" &&
	uci set "network.$NEW_IFACE=interface" &&
	uci set "network.$NEW_IFACE.device=$NEW_DEVICE" &&
	uci set "network.$NEW_IFACE.proto=dhcp" &&
	uci set "network.$NEW_IFACE.metric=$((NEW_SLOT * 10))" &&
	uci set "network.$NEW_IFACE.defaultroute=0" &&
	uci set "network.$NEW_IFACE.peerdns=0" &&
	uci set "network.$NEW_IFACE.delegate=0" &&
	uci add_list "$ZONE.network=$NEW_IFACE" &&
	"$AUTH_COMMAND" import "$NEW_IFACE" <"$PENDING_DIR/value.json" &&
	uci commit network && uci commit firewall &&
	/etc/init.d/network reload && ifup "$NEW_IFACE"
}

reload_firewall_for_path() {
	# Validate before applying; a vendor wrapper may return the status of a
	# missing optional include after nft has successfully loaded the rules.
	fw4 -q check || { echo 'Error: new WAN firewall validation failed.' >&2; return 1; }
	FIREWALL_CODE=0
	/etc/init.d/firewall reload || FIREWALL_CODE=$?
	# Require this newly allocated device in both forwarding and NAT dispatch.
	# Existing fw4 tables alone cannot prove that this reload took effect.
	nft list chain inet fw4 accept_to_wan 2>/dev/null |
		grep -F "\"$NEW_DEVICE\"" | grep -q ' accept' &&
	nft list chain inet fw4 srcnat 2>/dev/null |
		grep -F "\"$NEW_DEVICE\"" | grep -q 'jump srcnat_wan' || {
		echo 'Error: new WAN firewall rules were not loaded; rolling back.' >&2; return 1;
	}
	[ "$FIREWALL_CODE" = 0 ] ||
		echo 'Firewall wrapper returned nonzero; new WAN forwarding and NAT rules verified.' >&2
	return 0
}

cmd_add_random() {
	# Fail before prompting when there is no capacity or required runtime.
	find_free_slot >/dev/null || { echo 'Error: no free WAN slot.' >&2; return 4; }
	for REQUIRED in flock stat hexdump uci ubus jsonfilter curl ifup ifdown fw4 nft; do
		command -v "$REQUIRED" >/dev/null || { echo "Error: missing $REQUIRED." >&2; return 1; }
	done
	[ -r /dev/urandom ] && [ -x "$AUTH_COMMAND" ] && [ -x "$UPDATE_COMMAND" ] &&
		[ -d /sys/module/macvlan ] && [ -d "/sys/class/net/$PARENT_DEVICE" ] &&
		[ -x /etc/init.d/network ] && [ -x /etc/init.d/firewall ] || {
		echo 'Error: random WAN runtime is unavailable.' >&2; return 1;
	}
	uci -q show network >/dev/null || { echo 'Error: cannot read network configuration.' >&2; return 1; }
	ZONE="$(wan_zone)" || { echo 'Error: WAN firewall zone not found.' >&2; return 5; }
	history_storage || { echo 'Error: private storage is unavailable.' >&2; return 1; }
	PREPARE_ACTION=prepare
	[ "${1:-}" != --stdin ] || PREPARE_ACTION=prepare-import
	PENDING_DIR="$("$AUTH_COMMAND" "$PREPARE_ACTION")" || { PENDING_DIR=""; echo 'Error: credential input failed or was cancelled.' >&2; return 1; }
	case "$PENDING_DIR" in "$AUTH_DIR"/.pending.*) ;; *) PENDING_DIR=""; return 1 ;; esac
	[ ! -L "$PENDING_DIR" ] && [ -d "$PENDING_DIR" ] &&
		[ "$(stat -c '%u:%a' "$PENDING_DIR")" = 0:700 ] &&
		[ ! -L "$PENDING_DIR/value.json" ] && [ -f "$PENDING_DIR/value.json" ] &&
		[ "$(stat -c '%u:%a' "$PENDING_DIR/value.json")" = 0:600 ] || return 1
	acquire_management_lock || return 1
	NEW_SLOT="$(find_free_slot)" || { echo 'Error: no free WAN slot remains.' >&2; return 4; }
	uci -q show network >/dev/null || return 1
	initialize_history || return 1
	TRIES=0
	while [ "$TRIES" -lt 32 ]; do
		RANDOM_BYTES="$(hexdump -n 5 -v -e '1/1 "%02x:"' /dev/urandom 2>/dev/null)" || {
			echo 'Error: random source failed.' >&2; return 1;
		}
		NEW_MAC="02:${RANDOM_BYTES%:}"
		printf '%s' "$NEW_MAC" | grep -Eq '^02(:[0-9a-f]{2}){5}$' || { echo 'Error: random source failed.' >&2; return 1; }
		grep -Fqx "$NEW_MAC" "$HISTORY" || break
		TRIES=$((TRIES + 1))
	done
	[ "$TRIES" -lt 32 ] || { echo 'Error: random MAC collision limit reached.' >&2; return 1; }
	printf '%s\n' "$NEW_MAC" >>"$HISTORY" || return 1
	NEW_IFACE="wan$NEW_SLOT"; NEW_DSEC="wan${NEW_SLOT}dev"; NEW_DEVICE="macwan$NEW_SLOT"
	wait_for_updater
	[ ! -d "$LOCK" ] && backup_network || return 1
	ROLLBACK=1
	create_random_path || { echo 'Error: new WAN creation failed; rolling back.' >&2; return 1; }
	if ! wait_for_mac "$NEW_DEVICE" "$NEW_MAC"; then
		echo 'Error: new WAN device MAC did not apply; rolling back.' >&2; return 1
	fi
	reload_firewall_for_path || return 1
	# Network + private credentials are complete. Authentication failure retains them.
	ROLLBACK=0
	IP="$(wait_for_ip "$NEW_IFACE")"
	run_update || return 1
	if [ -z "$IP" ]; then
		echo "Created $NEW_IFACE: MAC=$NEW_MAC; retained offline (no DHCP). Use auth set and manual refresh."; return 1
	fi
	AUTH_OK=0
	"$AUTH_COMMAND" login "$NEW_IFACE" &
	AUTH_PIDS="$!"
	wait "$AUTH_PIDS" && AUTH_OK=1
	AUTH_PIDS=""
	run_update || return 1
	if [ "$AUTH_OK" = 1 ] && grep -q "^$NEW_IFACE .* state=active" "$STATUS_FILE"; then
		echo "Added and authenticated $NEW_IFACE: MAC=$NEW_MAC IP=$IP"; return 0
	fi
	echo "Created $NEW_IFACE: MAC=$NEW_MAC; retained offline. Credentials retained; correct them and run manual refresh."
	return 1
}

backup_network() {
	BACKUP_DIR=/root/hitwh-mwan-backups
	mkdir -p "$BACKUP_DIR"
	chmod 700 "$BACKUP_DIR"
	cp /etc/config/network "$BACKUP_DIR/network-$(date +%Y%m%d-%H%M%S)" || return 1
	# Bound flash usage; only this command's own flat network snapshots expire.
	ls -1t "$BACKUP_DIR"/network-* 2>/dev/null | awk 'NR>8' | while IFS= read -r OLD_BACKUP; do
		[ ! -f "$OLD_BACKUP" ] || rm -f "$OLD_BACKUP"
	done
}

find_device_section() {
	for DEV_SECTION in $(uci show network | sed -n 's/^\(network\.[^.]*\)=device$/\1/p'); do
		[ "$(uci -q get "$DEV_SECTION.name")" = "$1" ] || continue
		echo "$DEV_SECTION"
		return 0
	done
	return 1
}

runtime_mac() {
	normalize_mac "$(cat "/sys/class/net/$1/address" 2>/dev/null)"
}

read_main_mac() {
	MAIN_DEVICE="$(uci -q get "network.$MAIN_INTERFACE.device")"
	[ -n "$MAIN_DEVICE" ] || MAIN_DEVICE="$PARENT_DEVICE"
	MAIN_DEV_SECTION="$(find_device_section "$MAIN_DEVICE" || true)"
	MAIN_CONFIG_MAC="$(normalize_mac "$(uci -q get "network.$MAIN_INTERFACE.macaddr")")"
	MAIN_DEVICE_MAC=""
	[ -z "$MAIN_DEV_SECTION" ] || MAIN_DEVICE_MAC="$(normalize_mac "$(uci -q get "$MAIN_DEV_SECTION.macaddr")")"
	MAIN_RUNTIME_MAC="$(runtime_mac "$MAIN_DEVICE")"
}

main_uses_mac() {
	[ "$1" = "$MAIN_CONFIG_MAC" ] || [ "$1" = "$MAIN_DEVICE_MAC" ] || [ "$1" = "$MAIN_RUNTIME_MAC" ]
}

wait_for_mac() {
	MAC_WAIT=0
	while [ "$MAC_WAIT" -lt 5 ]; do
		ACTUAL_MAC="$(runtime_mac "$1")"
		[ "$ACTUAL_MAC" = "$2" ] && return 0
		sleep 1
		MAC_WAIT=$((MAC_WAIT + 1))
	done
	return 1
}

find_by_mac() {
	WANT="$(normalize_mac "$1")"
	N=2
	while [ "$N" -le "$MAX_PATHS" ]; do
		if [ "$N" -eq 6 ]; then N=$((N + 1)); continue; fi
		HAVE="$(normalize_mac "$(uci -q get "network.wan${N}dev.macaddr")")"
		[ -n "$HAVE" ] && [ "$HAVE" = "$WANT" ] && {
			echo "$N"
			return 0
		}
		N=$((N + 1))
	done
	return 1
}

is_managed_path() {
	SLOT="$1"
	IFACE="wan$SLOT"
	DSEC="wan${SLOT}dev"
	EXPECTED_DEV="macwan$SLOT"

	TYPE="$(uci -q get "network.$DSEC.type" || true)"
	PARENT="$(uci -q get "network.$DSEC.ifname" || true)"
	DEVICE="$(uci -q get "network.$IFACE.device" || true)"
	PROTO="$(uci -q get "network.$IFACE.proto" || true)"

	[ "$TYPE" = macvlan ] &&
		[ "$PARENT" = "$PARENT_DEVICE" ] &&
		[ "$DEVICE" = "$EXPECTED_DEV" ] &&
		[ "$PROTO" = dhcp ]
}

wait_for_ip() {
	IFACE="$1"
	WAIT=0
	IP=""
	while [ "$WAIT" -lt 30 ]; do
		IP="$(ubus call "network.interface.$IFACE" status 2>/dev/null |
			jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)"
		[ -n "$IP" ] && break
		sleep 1
		WAIT=$((WAIT + 1))
	done
	echo "$IP"
}

cmd_set_main() {
	cmd_edit "$MAIN_INTERFACE" "$1" || return $?
	if [ "$MAIN_ENROLLED" = 0 ]; then
		uci set hitwh_mwan.main.main_enrolled=1 && uci commit hitwh_mwan || return 1
		run_update
	fi
}

cmd_add() {
	MAC="$(normalize_mac "$1")"
	valid_mac "$MAC" || {
		echo "Error: invalid, zero or multicast MAC address."
		exit 2
	}

	read_main_mac
	main_uses_mac "$MAC" && {
		echo "Error: this MAC is already used by the main WAN."
		exit 3
	}

	EXISTING="$(find_by_mac "$MAC" || true)"
	[ -z "$EXISTING" ] || {
		echo "This MAC is already configured as wan$EXISTING."
		exit 0
	}

	SLOT="$(find_free_slot || true)"
	[ -n "$SLOT" ] || {
		echo "Error: the configured maximum of $MAX_PATHS paths has been reached."
		exit 4
	}

	IFACE="wan$SLOT"
	DEV="macwan$SLOT"
	DSEC="wan${SLOT}dev"
	ZONE="$(wan_zone)" || {
		echo "Error: OpenWrt WAN firewall zone was not found."
		exit 5
	}

	wait_for_updater
	backup_network
	uci -q delete "network.$DSEC"
	uci set "network.$DSEC=device"
	uci set "network.$DSEC.name=$DEV"
	uci set "network.$DSEC.type=macvlan"
	uci set "network.$DSEC.ifname=$PARENT_DEVICE"
	uci set "network.$DSEC.mode=bridge"
	uci set "network.$DSEC.macaddr=$MAC"

	uci -q delete "network.$IFACE"
	uci set "network.$IFACE=interface"
	uci set "network.$IFACE.device=$DEV"
	uci set "network.$IFACE.proto=dhcp"
	uci set "network.$IFACE.metric=$((SLOT * 10))"
	uci set "network.$IFACE.defaultroute=0"
	uci set "network.$IFACE.peerdns=0"
	uci set "network.$IFACE.delegate=0"

	uci -q del_list "$ZONE.network=$IFACE" || true
	uci add_list "$ZONE.network=$IFACE"
	uci commit network
	uci commit firewall

	/etc/init.d/network reload
	ifup "$IFACE"
	/etc/init.d/firewall reload >/dev/null 2>&1 || true
	IP="$(wait_for_ip "$IFACE")"
	run_update

	if [ -n "$IP" ]; then
		STATE="$(grep "^$IFACE " "$STATUS_FILE" | sed -n 's/.* state=\([^ ]*\).*/\1/p')"
		echo "Added $IFACE: MAC=$MAC IP=$IP state=${STATE:-unknown}"
	else
		echo "Created $IFACE, but DHCP has not returned an address. The monitor will retry."
	fi
}

resolve_slot() {
	ARG="$1"
	case "$ARG" in
		wan[0-9]*) echo "${ARG#wan}"; return 0 ;;
		*[!0-9]*|'')
			case "$ARG" in
				*:*) find_by_mac "$ARG"; return $? ;;
			esac
			;;
		*) echo "$ARG"; return 0 ;;
	esac
	return 1
}

cmd_edit() {
	MAC="$(normalize_mac "$2")"
	valid_mac "$MAC" || {
		echo "Error: invalid, zero or multicast MAC address."
		return 2
	}
	read_main_mac
	EXTRA_EDIT_KEY=""
	EXTRA_OLD_MAC=""
	CREATE_MAIN_DEVICE=0

	case "$1" in
		"$MAIN_INTERFACE"|wan1|1)
			EDIT_IFACE="$MAIN_INTERFACE"
			EDIT_DEVICE="$MAIN_DEVICE"
			EDIT_KEY="network.$MAIN_INTERFACE.macaddr"
			OLD_MAC="$MAIN_CONFIG_MAC"
			EXTRA_OLD_MAC="$MAIN_DEVICE_MAC"
			if [ -n "$MAIN_DEV_SECTION" ]; then
				EXTRA_EDIT_KEY="$MAIN_DEV_SECTION.macaddr"
			else
				# Modern OpenWrt applies L2 settings to device sections. Create
				# our own only when no named/anonymous section owns this device.
				NEW_DEV_SECTION=network.hitwh_main_device
				if uci -q get "$NEW_DEV_SECTION" >/dev/null; then
					echo "Error: $NEW_DEV_SECTION already configures another device."
					return 4
				fi
				CREATE_MAIN_DEVICE=1
				EXTRA_EDIT_KEY="$NEW_DEV_SECTION.macaddr"
			fi
			;;
		*)
			EDIT_SLOT="$(resolve_slot "$1" || true)"
			case "$EDIT_SLOT" in
				''|0*|*[!0-9]*) echo "Error: invalid WAN identifier."; return 2 ;;
			esac
			[ "$EDIT_SLOT" -ge 2 ] && [ "$EDIT_SLOT" -le "$MAX_PATHS" ] || {
				echo "Error: path number is out of range."
				return 2
			}
			EDIT_IFACE="wan$EDIT_SLOT"
			EDIT_DEVICE="macwan$EDIT_SLOT"
			EDIT_KEY="network.wan${EDIT_SLOT}dev.macaddr"
			OLD_MAC="$(normalize_mac "$(uci -q get "$EDIT_KEY")")"
			EXTRA_OLD_MAC="$(normalize_mac "$(uci -q get "network.$EDIT_IFACE.macaddr")")"
			[ -z "$EXTRA_OLD_MAC" ] || EXTRA_EDIT_KEY="network.$EDIT_IFACE.macaddr"
			;;
	esac
	uci -q get "network.$EDIT_IFACE" >/dev/null || {
		echo "Error: $EDIT_IFACE does not exist."
		return 3
	}
	if [ "$EDIT_IFACE" != "$MAIN_INTERFACE" ]; then
		[ "$EDIT_SLOT" -ne 6 ] && is_managed_path "$EDIT_SLOT" || {
			echo "Refusing to edit $EDIT_IFACE: it is not a managed HITwh multi-WAN path."
			return 4
		}
	fi
	if [ "$EDIT_IFACE" != "$MAIN_INTERFACE" ] && main_uses_mac "$MAC"; then
		echo "Error: this MAC is already used by $MAIN_INTERFACE."
		return 3
	fi
	EXISTING="$(find_by_mac "$MAC" || true)"
	if [ -n "$EXISTING" ] && [ "wan$EXISTING" != "$EDIT_IFACE" ]; then
		echo "Error: this MAC is already used by wan$EXISTING."
		return 3
	fi
	RUNTIME_MAC="$(runtime_mac "$EDIT_DEVICE")"
	if [ "$MAC" = "$RUNTIME_MAC" ] &&
		{ [ -z "$OLD_MAC" ] || [ "$MAC" = "$OLD_MAC" ]; } &&
		{ [ -z "$EXTRA_OLD_MAC" ] || [ "$MAC" = "$EXTRA_OLD_MAC" ]; }; then
		echo "$EDIT_IFACE already uses MAC=$MAC. No changes."
		return 0
	fi

	wait_for_updater
	[ ! -d "$LOCK" ] || { echo "Error: the WAN updater is busy; retry shortly."; return 1; }
	backup_network || return 1
	if [ "$CREATE_MAIN_DEVICE" = 1 ]; then
		uci set "$NEW_DEV_SECTION=device" || return 1
		uci set "$NEW_DEV_SECTION.name=$EDIT_DEVICE" || return 1
	fi
	uci set "$EDIT_KEY=$MAC" || return 1
	[ -z "$EXTRA_EDIT_KEY" ] || uci set "$EXTRA_EDIT_KEY=$MAC" || return 1
	if ! uci commit network; then
		uci -q revert "$EDIT_KEY" || true
		[ -z "$EXTRA_EDIT_KEY" ] || uci -q revert "$EXTRA_EDIT_KEY" || true
		[ "$CREATE_MAIN_DEVICE" = 0 ] || uci -q revert "$NEW_DEV_SECTION" || true
		echo "Error: could not save the MAC change."
		return 1
	fi
	ifdown "$EDIT_IFACE" || true
	# Withdraw the down path and move the router's default exit before waiting
	# for the replacement MAC's DHCP. Other paths keep their routing marks.
	run_update >/dev/null 2>&1 || true
	if ! /etc/init.d/network reload; then
		ifup "$EDIT_IFACE" || true
		echo "Error: MAC saved, but network reload failed."
		return 1
	fi
	ifup "$EDIT_IFACE" || return 1
	if ! wait_for_mac "$EDIT_DEVICE" "$MAC"; then
		run_update >/dev/null 2>&1 || true
		echo "Error: requested MAC=$MAC, but $EDIT_DEVICE uses MAC=${ACTUAL_MAC:-unavailable}. MAC change was not applied."
		return 1
	fi
	IP="$(wait_for_ip "$EDIT_IFACE")"
	run_update || return 1
	if [ -n "$IP" ]; then
		STATE="$(grep "^$EDIT_IFACE " "$STATUS_FILE" | sed -n 's/.* state=\([^ ]*\).*/\1/p')"
		echo "Updated $EDIT_IFACE: MAC=$MAC IP=$IP state=${STATE:-unknown}"
	else
		echo "Updated $EDIT_IFACE: MAC=$MAC ip=none state=no-dhcp. DHCP has not returned an address yet."
	fi
}

cmd_remove() {
	case "$1" in "$MAIN_INTERFACE"|wan1|1)
		[ "$MAIN_ENROLLED" != 0 ] || { echo 'Main path is not enrolled.'; return 3; }
		initialize_history && backup_network && "$AUTH_COMMAND" remove "$MAIN_INTERFACE" || return 1
		uci set hitwh_mwan.main.main_enrolled=0 && uci commit hitwh_mwan || return 1
		run_update || return 1
		echo "Removed $MAIN_INTERFACE from the pool. Physical uplink retained."
		return 0 ;;
	esac
	SLOT="$(resolve_slot "$1" || true)"
	case "$SLOT" in
		''|0*|1|*[!0-9]*)
			echo "Error: only wan2 through wan$MAX_PATHS can be removed."
			exit 2
			;;
	esac
	[ "$SLOT" -le "$MAX_PATHS" ] || {
		echo "Error: path number is out of range."
		exit 2
	}

	IFACE="wan$SLOT"
	DSEC="wan${SLOT}dev"
	uci -q get "network.$IFACE" >/dev/null || {
		echo "$IFACE does not exist."
		exit 3
	}
	[ "$SLOT" -ne 6 ] && is_managed_path "$SLOT" || {
		echo "Refusing to remove $IFACE: it was not created by HITwh dorm multi-WAN."
		exit 4
	}
	ZONE="$(wan_zone)" || exit 5

	# Persist all known addresses before removing this identity.
	initialize_history || exit 1
	"$AUTH_COMMAND" remove "$IFACE" || exit 1
	wait_for_updater
	backup_network
	ifdown "$IFACE" || true
	uci -q delete "network.$IFACE"
	uci -q delete "network.$DSEC"
	uci -q del_list "$ZONE.network=$IFACE" || true
	uci commit network
	uci commit firewall
	/etc/init.d/network reload
	/etc/init.d/firewall reload >/dev/null 2>&1 || true
	run_update
	echo "Removed $IFACE. Existing connections on that path were closed."
}

cmd_list() {
	run_update
	print_status
}

print_status() {
	cat "$STATUS_FILE"
	if [ "$MAIN_ENROLLED" != 0 ] && ! grep -q "^$MAIN_INTERFACE " "$STATUS_FILE"; then
		MAC="$(uci -q get "network.$MAIN_INTERFACE.macaddr")"
		[ -n "$MAC" ] || MAC="$(cat "/sys/class/net/$PARENT_DEVICE/address" 2>/dev/null)"
		echo "$MAIN_INTERFACE mac=$MAC ip=none state=no-dhcp mark=0x101"
	fi

	N=2
	while [ "$N" -le "$MAX_PATHS" ]; do
		if [ "$N" -eq 6 ]; then N=$((N + 1)); continue; fi
		if is_managed_path "$N" && ! grep -q "^wan$N " "$STATUS_FILE"; then
			MAC="$(uci -q get "network.wan${N}dev.macaddr")"
			echo "wan$N mac=$MAC ip=none state=no-dhcp"
		fi
		N=$((N + 1))
	done
}

managed_paths() {
	[ "$MAIN_ENROLLED" = 0 ] || echo "$MAIN_INTERFACE"
	N=2
	while [ "$N" -le "$MAX_PATHS" ]; do
		if [ "$N" -eq 6 ]; then N=$((N + 1)); continue; fi
		is_managed_path "$N" && echo "wan$N"
		N=$((N + 1))
	done
}

cmd_refresh() {
	TARGET_IFACE="${1:-}"
	if [ -n "$TARGET_IFACE" ]; then
		FOUND=0
		for CANDIDATE in $(managed_paths); do [ "$CANDIDATE" != "$TARGET_IFACE" ] || FOUND=1; done
		[ "$FOUND" = 1 ] || { echo 'Error: not a managed path.' >&2; return 2; }
	fi
	start_refresh_budget
	run_update || return 1
	OFFLINE=""
	for IFACE in $(managed_paths); do
		[ -z "$TARGET_IFACE" ] || [ "$IFACE" = "$TARGET_IFACE" ] || continue
		grep -q "^$IFACE .* state=active" "$STATUS_FILE" || OFFLINE="$OFFLINE $IFACE"
	done

	set -- $OFFLINE
	ATTEMPTED=$#
	if [ "$ATTEMPTED" -eq 0 ]; then
		print_status
		echo "RESULT 0 0 0"
		return 0
	fi

	# Authentication does not require interrupting an addressed interface.
	# Only missing DHCP addresses need the legacy interface reconnect.
	RECONNECT=""
	for IFACE in "$@"; do
		IP="$(ubus call "network.interface.$IFACE" status 2>/dev/null |
			jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)"
		[ -n "$IP" ] || RECONNECT="$RECONNECT $IFACE"
	done
	if [ -n "$RECONNECT" ]; then
		for IFACE in $RECONNECT; do ifdown "$IFACE" >/dev/null 2>&1 || true; done
		sleep 1
		for IFACE in $RECONNECT; do ifup "$IFACE" >/dev/null 2>&1 || true; done
	fi

	WAIT=0
	while [ "$WAIT" -lt 20 ]; do
		PENDING=0
		for IFACE in "$@"; do
			IP="$(ubus call "network.interface.$IFACE" status 2>/dev/null |
				jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)"
			[ -n "$IP" ] || PENDING=$((PENDING + 1))
		done
		[ "$PENDING" -eq 0 ] && break
		sleep 1
		WAIT=$((WAIT + 1))
	done

	run_update || return 1
	# At most three source-bound login attempts at once. No other manager,
	# updater, monitor, or hotplug action calls the login helper.
	BATCH=0
	for IFACE in "$@"; do
		grep -q "^$IFACE .* state=active" "$STATUS_FILE" && continue
		if [ -x "$AUTH_COMMAND" ]; then
			"$AUTH_COMMAND" login "$IFACE" &
			AUTH_PIDS="$AUTH_PIDS $!"
		else
			printf 'AUTH_RESULT %s helper_unavailable\n' "$IFACE"
		fi
		BATCH=$((BATCH + 1))
		if [ "$BATCH" -eq 3 ]; then wait_auth_batch; BATCH=0; fi
	done
	wait_auth_batch
	run_update || return 1
	REMAINING=0
	for IFACE in "$@"; do
		grep -q "^$IFACE .* state=active" "$STATUS_FILE" || REMAINING=$((REMAINING + 1))
	done
	RECOVERED=$((ATTEMPTED - REMAINING))
	print_status
	echo "RESULT $ATTEMPTED $RECOVERED $REMAINING"
	[ "$REMAINING" -eq 0 ]
}

cmd_speed() {
	SECONDS_TO_RUN="${1:-0}"
	case "$SECONDS_TO_RUN" in *[!0-9]*) echo "Error: seconds must be an integer."; exit 2 ;; esac
	COUNTER="/sys/class/net/$PARENT_DEVICE/statistics/rx_bytes"
	[ -r "$COUNTER" ] || {
		echo "Error: cannot read RX counter for $PARENT_DEVICE."
		exit 3
	}

	LAST="$(cat "$COUNTER")"
	ELAPSED=0
	while [ "$SECONDS_TO_RUN" -eq 0 ] || [ "$ELAPSED" -lt "$SECONDS_TO_RUN" ]; do
		sleep 1
		NOW="$(cat "$COUNTER")"
		awk -v bytes="$((NOW - LAST))" 'BEGIN { printf "%.2f MB/s\n", bytes / 1048576 }'
		LAST="$NOW"
		ELAPSED=$((ELAPSED + 1))
	done
}

case "$1" in
    upgrade)
        [ "$#" -eq 1 ] || { usage; exit 1; }
        exec /usr/libexec/hitwh-mwan-upgrade
        ;;
	set-main)
		[ -n "$2" ] || { usage; exit 1; }
		acquire_management_lock || exit 1
		cmd_set_main "$2"
		;;
	add)
		if [ "$2" = random ]; then
			[ "$#" -eq 2 ] || { [ "$#" -eq 3 ] && [ "$3" = --stdin ]; } || { usage; exit 1; }
			cmd_add_random "${3:-}"
		else
			[ "$#" -eq 2 ] || { usage; exit 1; }
			acquire_management_lock || exit 1; cmd_add "$2"
		fi
		;;
	edit)
		[ "$#" -eq 3 ] || { usage; exit 1; }
		acquire_management_lock || exit 1
		cmd_edit "$2" "$3"
		;;
	remove)
		[ -n "$2" ] || { usage; exit 1; }
		acquire_management_lock || exit 1
		cmd_remove "$2"
		;;
	list)
		cmd_list
		;;
	refresh)
		[ "$#" -le 2 ] || { usage; exit 1; }
		acquire_management_lock || exit 1
		cmd_refresh "${2:-}"
		;;
	auth)
		case "$2" in
			status)
				if [ "$#" -eq 2 ]; then
					for AUTH_IFACE in $(managed_paths); do "$AUTH_COMMAND" status "$AUTH_IFACE" || exit 1; done
				elif [ "$#" -eq 3 ]; then "$AUTH_COMMAND" status "$3"
				else usage; exit 1; fi ;;
			set|get|import|remove)
				[ "$#" -eq 3 ] || { usage; exit 1; }
				[ "$2" = get ] || acquire_management_lock || exit 1
				"$AUTH_COMMAND" "$2" "$3" ;;
			*) usage; exit 1 ;;
		esac
		;;
	portal)
		[ "$#" -le 2 ] || { usage; exit 1; }
		"$AUTH_COMMAND" discover "${2:-$MAIN_INTERFACE}"
		;;
	speed)
		cmd_speed "$2"
		;;
	*)
		usage
		exit 1
		;;
esac
