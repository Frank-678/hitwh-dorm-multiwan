#!/bin/sh

LOCK=/var/run/hitwh-mwan-update.lock
CHECKDIR="/tmp/hitwh-mwan-check.$$"
PATHFILE="/tmp/hitwh-mwan-paths.$$"
RULES="/tmp/hitwh-mwan-rules.$$"
RULES_STATE=/var/run/hitwh-mwan.rules
NFT_STATE=/var/run/hitwh-mwan.nft-state
NFT_CURRENT="/tmp/hitwh-mwan-nft.$$"
DNS_FILE=/var/run/hitwh-mwan.dns
DNS_CURRENT="/tmp/hitwh-mwan-dns.$$"
STATUS_FILE=/tmp/hitwh-mwan.status

MAX_PATHS="$(uci -q get hitwh_mwan.main.max_paths)"
LAN_DEVICE="$(uci -q get hitwh_mwan.main.lan_device)"
MAIN_INTERFACE="$(uci -q get hitwh_mwan.main.main_interface)"
HEALTH_URL="$(uci -q get hitwh_mwan.main.health_url)"
HEALTH_CODE="$(uci -q get hitwh_mwan.main.health_code)"
FALLBACK_GATEWAY="$(uci -q get hitwh_mwan.main.gateway)"
BALANCE_MODE="$(uci -q get hitwh_mwan.main.balance_mode)"
ROUTER_FAILOVER="$(uci -q get hitwh_mwan.main.router_failover)"

[ -n "$FALLBACK_GATEWAY" ] || FALLBACK_GATEWAY=10.240.255.254
[ -n "$MAX_PATHS" ] || MAX_PATHS=17
[ -n "$LAN_DEVICE" ] || LAN_DEVICE=br-lan
[ -n "$MAIN_INTERFACE" ] || MAIN_INTERFACE=wan
[ -n "$HEALTH_URL" ] || HEALTH_URL=http://connectivitycheck.gstatic.com/generate_204
[ -n "$HEALTH_CODE" ] || HEALTH_CODE=204
[ -n "$ROUTER_FAILOVER" ] || ROUTER_FAILOVER=1
case "$ROUTER_FAILOVER" in
	0|1) ;;
	*) echo "Invalid router_failover: $ROUTER_FAILOVER (expected 0 or 1)" >&2; exit 2 ;;
esac

[ -n "$BALANCE_MODE" ] || BALANCE_MODE=round_robin
case "$BALANCE_MODE" in
	round_robin|random) ;;
	*) echo "Invalid balance_mode: $BALANCE_MODE (expected round_robin or random)" >&2; exit 2 ;;
esac

mkdir "$LOCK" 2>/dev/null || exit 0
mkdir -p "$CHECKDIR"
: >"$PATHFILE"
trap 'rm -rf "$LOCK" "$CHECKDIR" "$PATHFILE" "$RULES" "$NFT_CURRENT" "$DNS_CURRENT"' EXIT INT TERM

iface_status() {
	ubus call "network.interface.$1" status 2>/dev/null
}

get_ip() {
	iface_status "$1" | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null
}

get_dev() {
	iface_status "$1" | jsonfilter -e '@.l3_device' 2>/dev/null
}

DYNAMIC_GATEWAY="$(iface_status "$MAIN_INTERFACE" | jsonfilter -e '@.route[0].nexthop' 2>/dev/null)"
GATEWAY="${DYNAMIC_GATEWAY:-$FALLBACK_GATEWAY}"
[ -n "$GATEWAY" ] || exit 1

# Never empty a live policy table: falling through to the main WAN can destroy
# existing MASQUERADE connections when their output device changes.
ensure_guard() {
	GUARD_TABLE="$1"
	if ip -4 route show table "$GUARD_TABLE" exact default 2>/dev/null |
		grep -q '^unreachable default.*metric 42760'; then
		return 0
	fi
	ip -4 route replace unreachable default table "$GUARD_TABLE" metric 42760
}

route_matches() {
	ip -4 route show table "$1" exact "$2" 2>/dev/null |
		awk -v via="$3" -v dev="$4" -v src="$5" '
		{
			v = ""; d = ""; s = ""; m = 0
			for (i = 1; i < NF; i++) {
				if ($i == "via") v = $(i + 1)
				if ($i == "dev") d = $(i + 1)
				if ($i == "src") s = $(i + 1)
				if ($i == "metric") m = $(i + 1)
			}
			if (v == via && d == dev && s == src && m == 0) found = 1
		}
		END { exit !found }'
}

ensure_rule() {
	RULE_PRIORITY="$1"
	shift
	EXPECTED_RULE="$*"
	EXISTING_RULES="$(ip -4 rule show | awk -v p="$RULE_PRIORITY:" '
		$1 == p { $1 = ""; sub(/^ +/, ""); print }')"
	if ! printf '%s\n' "$EXISTING_RULES" | grep -Fqx "$EXPECTED_RULE"; then
		# Install the replacement before removing obsolete selectors.
		ip -4 rule add priority "$RULE_PRIORITY" "$@" || return 1
	fi
	printf '%s\n' "$EXISTING_RULES" |
	while IFS= read -r OLD_RULE; do
		[ -n "$OLD_RULE" ] && [ "$OLD_RULE" != "$EXPECTED_RULE" ] || continue
		# Split iproute2's selector text into arguments without evaluating it.
		set -- $OLD_RULE
		ip -4 rule del priority "$RULE_PRIORITY" "$@" || exit 1
	done
}

remove_router_rules() {
	# These two priorities belong only to the router's default-exit selector.
	for ROUTER_PRIORITY in 32000 32001; do
		while ip -4 rule show | grep -q "^$ROUTER_PRIORITY:"; do
			ip -4 rule del priority "$ROUTER_PRIORITY" || return 1
		done
	done
}

update_router_dns() {
	DNS_CONFIGURED=0
	[ "$(uci -q get 'dhcp.@dnsmasq[0].serversfile')" = "$DNS_FILE" ] || return 0
	DNS_CONFIGURED=1
	: >"$DNS_CURRENT"
	if [ "$ROUTER_FAILOVER" = 1 ]; then
		while IFS='|' read -r N IFACE DEV IP TABLE MARK MAC; do
			DNS_STATUS="$(iface_status "$IFACE")"
			# peerdns=0 keeps DHCP DNS in inactive; it is still usable when
			# explicitly bound to this path's address and source-routing rule.
			for SERVER in $(printf '%s\n' "$DNS_STATUS" | jsonfilter \
				-e '@["dns-server"][*]' -e '@.inactive["dns-server"][*]' 2>/dev/null | sort -u); do
				case "$SERVER" in
					''|*[!0-9.]*) continue ;;
				esac
				printf 'server=%s@%s\n' "$SERVER" "$IP" >>"$DNS_CURRENT"
			done
		done <"$PATHFILE"
	fi
	if ! cmp -s "$DNS_CURRENT" "$DNS_FILE"; then
		# Keep the inode: OpenWrt may bind-mount this file into dnsmasq's jail.
		cp "$DNS_CURRENT" "$DNS_FILE" || return 1
		# servers-file is re-read on SIGHUP, without restarting DHCP or WANs.
		killall -HUP dnsmasq 2>/dev/null || true
	fi
}

select_router_path() {
	ROUTER_INTERFACE=""
	ROUTER_STATE=unavailable
	PREVIOUS_ROUTER="$(sed -n 's/^router_interface://p' "$STATUS_FILE" 2>/dev/null)"
	ROUTER_PATH=""
	# Prefer the configured main WAN, then retain a healthy backup to avoid
	# unnecessary switches when an unrelated lower-numbered path recovers.
	for PREFERRED in "$MAIN_INTERFACE" "$PREVIOUS_ROUTER"; do
		[ -n "$PREFERRED" ] || continue
		while IFS='|' read -r N IFACE DEV IP TABLE MARK MAC; do
			if [ "$IFACE" = "$PREFERRED" ] && [ -f "$CHECKDIR/$N.ok" ]; then
				ROUTER_PATH="$N|$IFACE|$DEV|$IP|$TABLE|$MARK|$MAC"
				break
			fi
		done <"$PATHFILE"
		[ -z "$ROUTER_PATH" ] || break
	done
	if [ -z "$ROUTER_PATH" ]; then
		while IFS='|' read -r N IFACE DEV IP TABLE MARK MAC; do
			[ -f "$CHECKDIR/$N.ok" ] || continue
			ROUTER_PATH="$N|$IFACE|$DEV|$IP|$TABLE|$MARK|$MAC"
			break
		done <"$PATHFILE"
	fi
	if [ -n "$ROUTER_PATH" ]; then
		ROUTER_STATE=active
	else
		# An endpoint outage is not proof that every link died. Keep a
		# previous exit with an address, but never promote an unverified one.
		ROUTER_PATH="$(awk -F '|' -v iface="$PREVIOUS_ROUTER" '$2 == iface { print; exit }' "$PATHFILE")"
		[ -z "$ROUTER_PATH" ] || ROUTER_STATE=unverified
	fi
	if [ "$ROUTER_FAILOVER" = 0 ] || [ -z "$ROUTER_PATH" ]; then
		remove_router_rules || return 1
		[ "$ROUTER_FAILOVER" = 1 ] || ROUTER_STATE=disabled
		return 0
	fi
	ROUTER_INTERFACE="$(printf '%s\n' "$ROUTER_PATH" | cut -d '|' -f2)"
	ROUTER_TABLE="$(printf '%s\n' "$ROUTER_PATH" | cut -d '|' -f5)"
	# Preserve LAN and other specific main-table routes before consulting a
	# WAN table, which has a catch-all default. iif lo selects local traffic;
	# source-bound probes and existing marked flows match their earlier rules.
	ensure_rule 32000 from all lookup main suppress_prefixlength 0 || return 1
	ensure_rule 32001 from all fwmark 0/0xfff iif lo lookup "$ROUTER_TABLE" || return 1
}

setup_path() {
	N="$1"
	IFACE="$2"
	DEV="$(get_dev "$IFACE")"
	IP="$(get_ip "$IFACE")"
	[ -n "$DEV" ] && [ -n "$IP" ] || return 1

	TABLE=$((100 + N))
	MARK="$(printf '0x%x' "$((0x100 + N))")"
	MAC="$(cat "/sys/class/net/$DEV/address" 2>/dev/null)"

	ensure_guard "$TABLE" || return 1
	# The campus subnet route also makes the shared gateway reachable.
	if ! route_matches "$TABLE" "10.240.0.0/16" '' "$DEV" "$IP"; then
		ip -4 route replace table "$TABLE" "10.240.0.0/16" dev "$DEV" src "$IP" || return 1
	fi
	if ! route_matches "$TABLE" default "$GATEWAY" "$DEV" "$IP"; then
		ip -4 route replace table "$TABLE" default via "$GATEWAY" dev "$DEV" src "$IP" || return 1
	fi
	ensure_rule "$((1000 + TABLE))" from all fwmark "$MARK/0xfff" lookup "$TABLE" || return 1
	ensure_rule "$((1100 + TABLE))" from "$IP" lookup "$TABLE" || return 1
	echo "$N|$IFACE|$DEV|$IP|$TABLE|$MARK|$MAC" >>"$PATHFILE"
}

setup_path 1 "$MAIN_INTERFACE" || true
N=2
while [ "$N" -le "$MAX_PATHS" ]; do
	if [ "$N" -eq 6 ]; then N=$((N + 1)); continue; fi
	uci -q get "network.wan$N" >/dev/null && setup_path "$N" "wan$N" || true
	N=$((N + 1))
done

# Keep a terminal route for previously installed paths whose address/device is
# currently absent. Existing marks must not fall through to another NAT exit.
for TABLE in $(ip -4 rule show | awk -v max="$((100 + MAX_PATHS))" '
	$1 ~ /^[0-9]+:$/ && $2 == "from" && $3 == "all" && $4 == "fwmark" && $6 == "lookup" {
		p = $1 + 0; t = $7 + 0
		if (t >= 101 && t <= max && p == 1000 + t) print t
	}'); do
	ensure_guard "$TABLE" || exit 1
done

# DNS must work before the health checks, including at boot with no main DHCP.
update_router_dns || exit 1

# Check every path in parallel. A captive-portal response is not considered online.
while IFS='|' read -r N IFACE DEV IP TABLE MARK MAC; do
	(
		CODE="$(curl -4 -sS --interface "$IP" --connect-timeout 4 --max-time 7 \
			-o /dev/null -w '%{http_code}' "$HEALTH_URL" 2>/dev/null)"
		[ "$CODE" = "$HEALTH_CODE" ] && : >"$CHECKDIR/$N.ok"
	) &
done <"$PATHFILE"
wait

ACTIVE_MARKS=""
ACTIVE_NAMES=""
COUNT=0
while IFS='|' read -r N IFACE DEV IP TABLE MARK MAC; do
	if [ -f "$CHECKDIR/$N.ok" ]; then
		ACTIVE_MARKS="$ACTIVE_MARKS $MARK"
		ACTIVE_NAMES="$ACTIVE_NAMES $IFACE"
		COUNT=$((COUNT + 1))
	fi
done <"$PATHFILE"

select_router_path || exit 1

if ! nft list table inet hitwh_mwan >/dev/null 2>&1; then
	nft -f /usr/share/nftables.d/ruleset-post/90-hitwh-mwan.nft
fi

set -- $ACTIVE_MARKS
{
	echo 'flush chain inet hitwh_mwan prerouting'
	echo "add rule inet hitwh_mwan prerouting iifname \"$LAN_DEVICE\" ct state established,related meta mark set ct mark"
	if [ "$COUNT" -eq 1 ]; then
		echo "add rule inet hitwh_mwan prerouting iifname \"$LAN_DEVICE\" ct state new ct mark 0 meta l4proto { tcp, udp } ct mark set $1"
	elif [ "$COUNT" -gt 1 ]; then
		MAP=""
		IDX=0
		for MARK in "$@"; do
			[ -z "$MAP" ] || MAP="$MAP, "
			MAP="$MAP$IDX : $MARK"
			IDX=$((IDX + 1))
		done
		if [ "$BALANCE_MODE" = round_robin ]; then
			# Independent generators keep DNS/UDP traffic from consuming TCP slots.
			# Existing connections retain their ct mark; only new flows are selected.
			for PROTOCOL in tcp udp; do
				echo "add rule inet hitwh_mwan prerouting iifname \"$LAN_DEVICE\" ct state new ct mark 0 meta l4proto $PROTOCOL ct mark set numgen inc mod $COUNT map { $MAP }"
			done
		else
			echo "add rule inet hitwh_mwan prerouting iifname \"$LAN_DEVICE\" ct state new ct mark 0 meta l4proto { tcp, udp } ct mark set numgen random mod $COUNT map { $MAP }"
		fi
	fi
	echo "add rule inet hitwh_mwan prerouting iifname \"$LAN_DEVICE\" meta mark set ct mark"
	while IFS='|' read -r N IFACE DEV IP TABLE MARK MAC; do
		echo "add rule inet hitwh_mwan prerouting iifname \"$LAN_DEVICE\" meta mark $MARK counter"
	done <"$PATHFILE"
} >"$RULES"

# Compare both the desired batch and the live stateless chain. The live check
# repairs a firewall reload/manual drift even when our cached batch is intact.
if ! nft -s list chain inet hitwh_mwan prerouting >"$NFT_CURRENT" 2>/dev/null; then
	exit 1
fi
if ! cmp -s "$RULES" "$RULES_STATE" || ! cmp -s "$NFT_CURRENT" "$NFT_STATE"; then
	nft -f "$RULES" || exit 1
	nft -s list chain inet hitwh_mwan prerouting >"$NFT_CURRENT" || exit 1
	cp "$RULES" "$RULES_STATE"
	cp "$NFT_CURRENT" "$NFT_STATE"
fi

{
	date
	echo "active_count:$COUNT"
	echo "balance_mode:$BALANCE_MODE"
	echo "active_interfaces:$ACTIVE_NAMES"
	echo "router_failover:$ROUTER_FAILOVER"
	echo "router_interface:$ROUTER_INTERFACE"
	echo "router_state:$ROUTER_STATE"
	echo "router_dns_configured:$DNS_CONFIGURED"
	while IFS='|' read -r N IFACE DEV IP TABLE MARK MAC; do
		STATE=inactive
		[ -f "$CHECKDIR/$N.ok" ] && STATE=active
		echo "$IFACE mac=$MAC ip=$IP state=$STATE mark=$MARK"
	done <"$PATHFILE"
} >"$STATUS_FILE"

logger -t hitwh-mwan "active interfaces:$ACTIVE_NAMES"
