#!/bin/sh
[ -z "${IPKG_INSTROOT:-}" ] || exit 0
if [ "${1:-}" = remove ]; then
    /etc/init.d/hitwh-mwan stop >/dev/null 2>&1 || true
    /etc/init.d/hitwh-mwan disable >/dev/null 2>&1 || true
    /etc/init.d/hitwh-mwan-dns disable >/dev/null 2>&1 || true
    nft delete table inet hitwh_mwan >/dev/null 2>&1 || true
    for PRIORITY in 32000 32001; do
        while ip -4 rule show | grep -q "^$PRIORITY:"; do ip -4 rule del priority "$PRIORITY"; done
    done
    # Package removal/reinstallation never deletes network identities or secrets.
    if [ "$(uci -q get 'dhcp.@dnsmasq[0].serversfile')" = /var/run/hitwh-mwan.dns ]; then
        uci -q delete 'dhcp.@dnsmasq[0].serversfile'
        uci commit dhcp
        /etc/init.d/dnsmasq reload
    fi
fi
exit 0
